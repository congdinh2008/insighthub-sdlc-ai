# Copy once: cp .env.example .env
# Fixture is offline. For real evaluation: set RAG_MODE=real and fill both keys.
# Keep actual keys in .env only; never commit or send them in chat.
RAG_MODE=fixture
# Optional, fixture only: simulate provider faults, e.g. AI_FIXTURE_FAULTS=deepseek:timeout
AI_FIXTURE_FAULTS=

# Auth scaffold (bắt buộc): khóa ký cookie phiên, tối thiểu 32 ký tự ngẫu nhiên.
# Tạo bằng: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Mật khẩu chung của hai tài khoản thử A, B cho make seed-users (để trống thì script tự sinh).
# SEED_USER_PASSWORD=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# DeepSeek answers questions; Gemini creates embeddings. Reranker is off.
# Change models only when testing another configuration.
# DEEPSEEK_CHAT_MODEL=deepseek-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional: change only if the default ports are occupied.
# API_PORT=8107
# WEB_PORT=3107

# Providers, profile, limits, retries and retrieval settings have code defaults.
# Reranker is off. Advanced overrides: docs/Model_Profiles_And_Reranking.md

# MCP chỉ đọc (M0.2, LR-05): mật khẩu của role insighthub_readonly. Đặt rồi chạy: make mcp-role
# MCP_DB_READONLY_PASSWORD=
# DB_PORT=5433
