# InsightHub Starter v1.0.0-rc.2. Copy to .env. Never commit actual keys.
# No paid services or model downloads in the default profile.
RAG_MODE=fixture
RAG_PROFILE=fixture-offline
LLM_PROVIDER=fixture
EMBEDDING_PROVIDER=fixture
RERANKER_PROVIDER=none
API_PORT=8107
WEB_PORT=3107
LLM_MAX_TOKENS=1024
EMBEDDING_DIM=1024
EMBEDDING_REVISION=1
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_RETRY_ATTEMPTS=3
RERANKER_TIMEOUT_SECONDS=20
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_MIN_SIMILARITY=-1
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=3
CONTEXT_MAX_TOKENS=4000
RERANKER_TOP_N=5
INGESTION_TIMEOUT_SECONDS=120
CHAT_TIMEOUT_SECONDS=60
MAX_EXTRACTED_CHARS=200000
MAX_PDF_PAGES=100
# REAL mode: set RAG_MODE=real and both providers explicitly.
# LLM: gemini | anthropic | openai | ollama
# Embedding: gemini | voyage | openai | ollama
# Never reuse a populated fixture index for real embeddings. See GETTING_STARTED.
LLM_MODEL=
EMBEDDING_MODEL=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=
OPENAI_API_KEY=
# Explicit endpoint required, e.g. https://api.openai.com/v1 or a vetted gateway.
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5
COHERE_API_KEY=
COHERE_RERANKER_MODEL=rerank-v4.0-fast
LOCAL_RERANKER_URL=
LOCAL_RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
EXPOSE_DEBUG_CONTEXTS=false
AI_DATA_POLICY_URL=
AI_DATA_USAGE_NOTICE="Fixture offline không gửi dữ liệu tới provider bên ngoài."
# Chat model chosen after measuring available RAM/latency and quality.
# mxbai-embed-large emits 1024 dimensions; no padding/truncation.
