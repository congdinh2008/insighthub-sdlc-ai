# Copy to .env and replace GEMINI_API_KEY. Never commit .env.
RAG_MODE=real
RAG_PROFILE=classroom-gemini
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
RERANKER_PROVIDER=none
GEMINI_API_KEY=REPLACE_ME
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1024
EMBEDDING_REVISION=1
LLM_MAX_TOKENS=1024
PROVIDER_TIMEOUT_SECONDS=45
PROVIDER_RETRY_ATTEMPTS=3
INGESTION_TIMEOUT_SECONDS=120
CHAT_TIMEOUT_SECONDS=60
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
# Baseline only. Recalibrate against AEV when corpus/model changes.
RETRIEVAL_MIN_SIMILARITY=0.20
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=3
CONTEXT_MAX_TOKENS=4000
RERANKER_TOP_N=5
EXPOSE_DEBUG_CONTEXTS=false
AI_DATA_POLICY_URL=https://ai.google.dev/gemini-api/terms
AI_DATA_USAGE_NOTICE="Câu hỏi và trích đoạn tài liệu sẽ được gửi tới Gemini. Free Tier có điều khoản sử dụng dữ liệu khác Paid Tier. Không dùng dữ liệu nhạy cảm."
API_PORT=8107
WEB_PORT=3107
