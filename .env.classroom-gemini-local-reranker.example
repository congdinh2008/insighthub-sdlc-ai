# Start the optional TEI service first with: make reranker-local-up
RAG_MODE=real
RAG_PROFILE=classroom-gemini-local-reranker
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
RERANKER_PROVIDER=local
GEMINI_API_KEY=REPLACE_ME
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
LOCAL_RERANKER_URL=http://host.docker.internal:8187
LOCAL_RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base
EMBEDDING_DIM=1024
EMBEDDING_REVISION=1
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_MIN_SIMILARITY=0.20
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=3
CONTEXT_MAX_TOKENS=4000
RERANKER_TOP_N=5
RERANKER_TIMEOUT_SECONDS=30
PROVIDER_RETRY_ATTEMPTS=2
AI_DATA_POLICY_URL=https://ai.google.dev/gemini-api/terms
AI_DATA_USAGE_NOTICE="Embedding và generation dùng Gemini; reranking chạy trên máy local qua TEI. Không dùng dữ liệu nhạy cảm với Gemini Free Tier."
API_PORT=8107
WEB_PORT=3107
